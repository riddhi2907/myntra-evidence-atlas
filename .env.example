# Local development only. Streamlit Community Cloud uses its Secrets UI instead
# (see .streamlit/secrets.toml.example) -- config.py checks Streamlit secrets,
# then the environment, then this file.

# Required: the classifier.
GEMINI_API_KEY=

# Optional. Without it the YouTube source is skipped and reported as
# unavailable; the other three sources still run.
YOUTUBE_API_KEY=

# Optional. Fallback classifier, used only if Gemini fails twice (a free-tier
# 429 on the grader's click is the realistic failure mode).
GROQ_API_KEY=
