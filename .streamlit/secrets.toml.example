# Streamlit Community Cloud: paste these into
#   App -> Settings -> Secrets
# Do NOT commit a filled-in secrets.toml -- .gitignore excludes it.

# Required: the classifier.
GEMINI_API_KEY = "your-gemini-key"

# Optional. Without it the YouTube source is skipped and reported as
# unavailable; the other three sources still run.
YOUTUBE_API_KEY = "your-youtube-data-api-key"

# Optional. Fallback classifier, used only if Gemini fails twice.
GROQ_API_KEY = "your-groq-key"
